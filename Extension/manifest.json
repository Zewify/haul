{
  "manifest_version": 3,
  "name": "Haul",
  "version": "0.1.0",
  "description": "Hands your downloads to the Haul app, which fetches them over several connections and can resume them.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Haul",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["lib/links.js", "lib/media.js", "content.js"], "run_at": "document_start" }
  ],
  "permissions": ["downloads", "cookies", "contextMenus", "storage", "webRequest", "alarms"],
  "host_permissions": ["<all_urls>"]
}

// Committed signing defaults: ad-hoc, which is enough to build, test and run locally.
// A stable identity keeps macOS's Input Monitoring grant across rebuilds; put yours in
// Signing.local.xcconfig next to this file (gitignored), for example:
//
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = ABCDE12345
//
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
#include? "Signing.local.xcconfig"
